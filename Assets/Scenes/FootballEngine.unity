    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Mentalidade:\r\nAgressiva \u2014 +faltas, +desarmes, +cartoes \r\nEquilibrada
    \u2014 muda nada\r\nTranquila \u2014 -faltas, -desarmes, -cartoes\r\n\r\nTaticas:\r\nPosse
    de bola \u2014 +posse, +passes\r\nContra-ataque \u2014 -posse, +grandes chances,
    +finalizacoes certas, +chance de converter\r\nJogo direto \u2014 -posse, -passes,
    +finalizacoes, +chance de converter\r\nPadrao \u2014 muda nada\r\nPress\xE3o
    alta \u2014 +posse, +ataques totais, +finalizacoes, +chance de sofrer gol\r\nRetranca
    \u2014 --posse, --ataques totais, --finalizacoes, --chance de sofrer gol, -chance
    de converter\r\nArtilharia \u2014 ++finalizacoes, -finalizacoes certas\r\n"
